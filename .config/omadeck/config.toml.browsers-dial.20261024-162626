# omadeck configuration - edit by hand or with the `omadeck` app.

brightness = 75

[style]
follow_theme = true

[[key]]
index = 0
label = "Discord"
icon = "icons/omarchy-discord.png"

[key.action]
type = "app"
command = "omarchy launch or focus discord 'omarchy-launch-webapp https://discord.com/channels/@me'"

[[key]]
index = 1
label = "Element"
icon = "icons/io.element.Element.svg"
busy_while_running = true

[key.action]
type = "app"
command = "omarchy launch or focus element element-desktop"

[[key]]
index = 2
label = "Browser"
icon = "icons/brave-browser.png"

[key.action]
type = "app"
command = "omarchy launch browser"


[[key]]
index = 4
label = "LLM"
glyph = "󰚩"

[key.action]
type = "app"
command = "/usr/bin/magnitude models load qwen3.8-27b:gguf:q4"

[key.on]
label = "LLM ready"
glyph = "󰚩"
state = """s=$(tail -c 262144 /home/noobaf/.magnitude/logs/inference.log 2>/dev/null | grep "model.id=qwen3.8-27b" | grep -E "residency (transitioned|terminalized)" | grep -oE 'residency.state="[a-z]+"' | tail -1 | cut -d'"' -f2 | tr 'A-Z' 'a-z'); [ -n "$s" ] || s=$(/usr/bin/magnitude models status 2>/dev/null | awk 'NR>3 && NF {print $(NF-1); exit}' | tr 'A-Z' 'a-z'); case $s in ready) exit 0;; loading) p=$(/usr/bin/magnitude models status 2>/dev/null | awk 'NR>3 && NF { if ($(NF-1) ~ /%$/) print $(NF-2), $(NF-1); else print $(NF-1); exit }'); echo ${p:-Loading}; exit 75;; *) exit 1;; esac"""
interval = 5
slow = true

[key.on.action]
type = "app"
command = "/usr/bin/magnitude models stop"

[key.busy]
bar = true

[key.live]
source = "command"
command = """s=$(tail -c 262144 /home/noobaf/.magnitude/logs/inference.log 2>/dev/null | grep "model.id=qwen3.8-27b" | grep -E "residency (transitioned|terminalized)" | grep -oE 'residency.state="[a-z]+"' | tail -1 | cut -d'"' -f2 | sed 's/vacant/stopped/'); if [ "$s" = 'ready' ]; then /usr/bin/magnitude models status qwen3.8-27b:gguf:q4 2>/dev/null | head -1; else awk -v s="$s" 'BEGIN{print toupper(substr(s,1,1)) substr(s,2)}'; fi"""

[[key]]
index = 5
label = "OpenHands"
icon = "icons/openhands.png"

[key.action]
type = "app"
command = "systemctl --user start openhands-canvas"

[key.on]
label = "OpenHands"
icon = "icons/openhands.png"
state = "pgrep -f 'agent-[c]anvas' >/dev/null"
interval = 5
slow = true

[key.on.action]
type = "app"
command = "pkill -f 'agent-[c]anvas'; pkill -f 'agent-[s]erver'"

[[key]]
index = 6
label = "Play"
glyph = "󰐊"

[key.action]
type = "media"

[key.on]
label = "Pause"
glyph = "󰏤"

[[key]]
index = 7
label = "Dictation"
glyph = "󰍬"

[key.action]
type = "app"
command = "voxtype record start"

[key.release]
type = "script"
path = "dictation-stop.sh"

[[key]]
index = 8
label = "4"

[key.action]
type = "hyprland"
dispatch = "workspace 4"

[[key]]
index = 9
label = "5"

[key.action]
type = "hyprland"
dispatch = "workspace 5"

[[key]]
index = 10
label = "Mute"
glyph = "󰝟"

[key.action]
type = "app"
command = "omarchy audio output volume mute-toggle"

[[key]]
index = 11
label = "Night light"
glyph = "󰖔"

[key.action]
type = "app"
command = "omarchy toggle nightlight"

[[key]]
index = 12
label = "Wallpaper"
icon = "icons/preferences-desktop-wallpaper.png"

[key.action]
type = "app"
command = "omarchy theme bg next"

[[key]]
index = 13
label = "Ding!"
icon = "icons/audio-x-generic.png"

[key.action]
type = "sound"
file = "/usr/share/sounds/freedesktop/stereo/complete.oga"

[[key]]
index = 14
label = "Lock"
icon = "icons/system-lock-screen.png"

[key.action]
type = "app"
command = "omarchy system lock"

[[dial]]
index = 0
label = "Volume"
glyph = "f057e"

[dial.turn_left]
type = "volume"
change = -5

[dial.turn_right]
type = "volume"
change = 5

[dial.press]
type = "volume"
mute = true

[[dial]]
index = 1
label = "Brave"

[dial.turn_left]
type = "app_volume"
app = "brave"
change = -5

[dial.turn_right]
type = "app_volume"
focused = true
change = 5

[dial.press]
type = "app_volume"
focused = true
mute = true

[[dial]]
index = 2
label = "Mic"
glyph = "f036c"

[dial.turn_left]
type = "volume"
device = "input"
change = -5

[dial.turn_right]
type = "volume"
device = "input"
change = 5

[dial.press]
type = "volume"
device = "input"
mute = true

[[dial]]
index = 3
label = "Browsers"
icon = "icons/web-browser.png"

[dial.turn_left]
type = "app"
command = "omarchy launch or focus chromium 'chromium'"

[dial.turn_right]
type = "app"
command = "omarchy launch or focus brave 'brave-browser'"

[dial.press]
type = "app"
command = "omarchy launch or focus element 'io.element.Element.desktop'"

[[page]]
name = "Prompts"

[[page.key]]
index = 7
label = "/compact"

[page.key.action]
type = "script"
path = "prompt-compact.sh"
